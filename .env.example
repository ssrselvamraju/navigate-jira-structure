# Copy to .env and set values, or run `python3 scripts/setup.py` for an
# interactive prompt that writes this file for you.
# Do not commit .env.

# --- Data Center / Server (--target dc, default) ---
JIRA_URL=https://jira.example.com
JIRA_PERSONAL_TOKEN=

# --- Cloud (--target cloud) ---
# All five required together; never mix with the dc values above (see
# references/structure-rest.md and SKILL.md). STRUCTURE_CLOUD_TOKEN is a
# Structure-specific PAT (Structure's own personal settings page), NOT the
# same as JIRA_CLOUD_API_TOKEN.
# STRUCTURE_CLOUD_BASE_URL=https://api.structure.app/v1
# STRUCTURE_CLOUD_TOKEN=
# JIRA_CLOUD_BASE_URL=https://your-tenant.atlassian.net
# JIRA_CLOUD_EMAIL=
# JIRA_CLOUD_API_TOKEN=
