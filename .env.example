# Copy to .env and set values, or run `python3 scripts/setup.py` for an
# interactive prompt that writes this file for you.
# Do not commit .env.

# --- Cloud (--target cloud, default) ---
STRUCTURE_CLOUD_BASE_URL=https://api.structure.app/v1
STRUCTURE_CLOUD_TOKEN=
JIRA_CLOUD_BASE_URL=https://your-tenant.atlassian.net
JIRA_CLOUD_EMAIL=
JIRA_CLOUD_API_TOKEN=

# --- Data Center / Server (--target dc) ---
# Never mix with the cloud values above (see references/structure-rest.md
# and SKILL.md).
# JIRA_URL=https://jira.example.com
# JIRA_PERSONAL_TOKEN=
